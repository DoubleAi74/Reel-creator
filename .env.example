# Reel Creator local environment template.
# Copy to .env.local and fill in values there. Never commit real secrets.

# Core AI
OPENAI_API_KEY=
OPENAI_MAX_ATTEMPTS=3
OPENAI_REQUEST_TIMEOUT_MS=90000
OPENAI_CONTENT_REQUEST_TIMEOUT_MS=240000
OPENAI_TRANSCRIPTION_CHUNK_SECONDS=45
OPENAI_CONTENT_SINGLE_CALL_MAX_MB=24
OPENAI_TIMING_PROMPT_MODE=lyrics
OPENAI_NO_SPEECH_PROB_MAX=0.6
OPENAI_AVG_LOGPROB_MIN=-1
OPENAI_COMPRESSION_RATIO_MAX=2.4
OPENAI_LYRIC_POLISH_MODEL=
OPENAI_SOURCE_REPAIR_MODEL=
OPENAI_QA_AUDIT_MODEL=
OPENAI_PRICE_TABLE_JSON=

# Local assets and workers
TMP_DIR=
ASSET_TTL_HOURS=24
MAX_AUDIO_MB=25
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
TRANSCRIBE_CONCURRENCY=1
RENDER_CONCURRENCY=1

# Credit dashboard kill switch. Leave false until CREDITS_SETUP.md checks pass.
CREDITS_ENABLED=false
MIN_GENERATION_BALANCE_MINOR=1
INITIAL_BALANCE_MINOR=500

# MongoDB. Credits require a replica set because debits/top-ups use transactions.
MONGODB_URI=
MONGODB_DB_NAME=

# Generation password gate
GENERATION_PASSWORD=
GENERATION_UNLOCK_SECRET=
GENERATION_UNLOCK_TTL_SECONDS=43200
GEN_RATE_MAX=20
GEN_RATE_WINDOW_SECONDS=3600

# Public app/payment URLs
APP_BASE_URL=http://localhost:3000

# SumUp hosted checkout. Use sandbox credentials until ready for live money.
SUMUP_MODE=sandbox
SUMUP_API_BASE_URL=https://api.sumup.com
SUMUP_API_KEY=
SUMUP_API_KEY_TEST=
SUMUP_API_KEY_LIVE=
SUMUP_MERCHANT_CODE=
SUMUP_MERCHANT_CODE_TEST=
SUMUP_MERCHANT_CODE_LIVE=
SUMUP_CURRENCY=GBP
SUMUP_WEBHOOK_URL=
SUMUP_CHECKOUT_RETURN_URL=
ALLOW_TEMP_LIVE_PAYMENT_URLS=false

# Cloudflare R2 for saved generation audio playback.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Visual parity helpers
REFERENCE_URL=
CURRENT_URL=
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
